<?xml version="1.0" encoding="utf-8"?>
<!--
    CHAMELEON ACCESSIBILITY SERVICE CONFIG
    =======================================
    CRITICAL SECURITY RULES:
    1. packageNames MUST be a specific whitelist — NO wildcards, NO empty string
    2. accessibilityEventTypes must be minimal — only what is needed
    3. canRetrieveWindowContent="true" is required for text reading
    4. This list MUST be reviewed before each release

    Adding a package to this whitelist is a SECURITY DECISION.
    It grants Chameleon read access to that app's text content.
    Never add packages without explicit user awareness.

    PACKAGE AUDIT (2026-05-10):
    - org.signal.qr REMOVED — does not exist as standalone app (Signal QR is part of main app)
    - All remaining packages verified against Google Play Store package names

    INSTRUCTIONS FOR ADDING NEW PACKAGES:
    1. Add to this whitelist
    2. Verify package name against Play Store (adb shell pm list packages | grep <name>)
    3. Add to CHANGELOG.md explaining why
    4. Notify users in release notes
    5. Consider privacy implications for that app's users
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"

    android:accessibilityEventTypes="typeViewTextChanged|typeViewFocused|typeWindowContentChanged"

    android:accessibilityFeedbackType="feedbackGeneric"

    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"

    android:canRetrieveWindowContent="true"

    android:description="@string/accessibility_service_description"

    android:notificationTimeout="100"

    android:packageNames="
        org.thoughtcrime.securesms,
        org.telegram.messenger,
        com.whatsapp,
        com.whatsapp.w4b,
        com.viber.voip,
        com.discord,
        com.wire,
        im.vector.app,
        ch.threema.app,
        com.skype.raider,
        com.facebook.orca,
        com.instagram.android,
        com.google.android.gm,
        com.microsoft.office.outlook
    "

    android:settingsActivity="com.stealthx.chameleon.MainActivity" />
